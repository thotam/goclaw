# Extend official goclaw image, thêm claude CLI vào
# Không cần build từ source Go — chỉ cần file này + docker-compose.all.yml
ARG VERSION=full
FROM ghcr.io/nextlevelbuilder/goclaw:${VERSION}

# Thêm Alpine edge repo để lấy postgresql18-client (PG18, chưa có trên stable)
# nodejs/npm đã có sẵn trong base image full — không cần cài lại
RUN echo "@edge https://dl-cdn.alpinelinux.org/alpine/edge/community" >> /etc/apk/repositories \
    && apk add --no-cache postgresql18-client@edge xdotool scrot xdpyinfo \
    && rm -rf /var/cache/apk/* \
    && npm install -g @anthropic-ai/claude-code \
    && claude --version \
    && echo "Claude CLI installed successfully"
